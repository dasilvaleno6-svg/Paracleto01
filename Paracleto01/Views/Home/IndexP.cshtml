
	 @{
          Layout = "_LayoutP";
      }

      <main class="app-main">

				<div class="app-topbar">
					<h2>Painel geral</h2>
					<div class="who">Bem-vindo(a), Carissimo Docente</div>
				</div>


			   <div class="panel">
					<div class="panel-head">
						<h3>Atividade recente</h3>
					</div>
					<div>
						<div class="info">
						  <div class="name">Prof. Carlos Mendes</div>
						  <div class="meta">Matemática</div>
						  <div class="meta">Turmas: 9ºA, 9ºB, 11ºB</div>
						</div>
					</div>
			   </div>

			   <div class="metric-grid" style="grid-template-columns:repeat(3,1fr);">

						<div class="metric">
							<div class="lbl">Turmas atribuídas</div>
							<div class="val">3</div>
						</div>

						<div class="metric">
							<div class="lbl">Total de alunos</div>
							<div class="val">2</div>
						</div>

						<div class="metric">
							<div class="lbl">Notas lançadas (1º período)</div>
							<div class="val">1</div>
						</div>
			   </div>

				<div class="panel">

					<table class="timetable">
						<ttable>
							<tr>
								<th>Hora</th>
								<th>Segunda</th>
								<th>Terça</th>
								<th>Quarta</th>
								<th>Quinta</th>
								<th>Sexta</th>
							</tr>

							<tr>
								<td style="font-weight:600;color:var(--ink-700)">08:15–09:45</td>
								<td>
									<span class="slot">Matemática · 9ºA</span>
								</td>
								<td>
									<span class="slot">Matemática · 9ºB</span>
								</td>
								<td>
									<span class="slot">Matemática · 11ºB</span>
								</td>
								<td>
									<span class="slot">Matemática · 9ºA</span>
								</td>
								<td>
									<span class="slot">Matemática · 9ºB</span>
								</td>
							</tr>

							<tr>
								<td style="font-weight:600;color:var(--ink-700)">10:05–11:35</td>
								<td>
									<span class="slot">Matemática · 9ºB</span>
								</td>
								<td>
									<span class="slot">Matemática · 11ºB</span>
								</td>
								<td>
									<span class="slot">Matemática · 9ºA</span>
								</td>
								<td>
									<span class="slot">Matemática · 9ºB</span>
								</td>
								<td>
									<span class="slot">Matemática · 11ºB</span>
								</td>
							</tr>
						</ttable>
					</table>

				</div>

			</main>
