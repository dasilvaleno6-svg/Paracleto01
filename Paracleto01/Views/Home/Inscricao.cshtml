@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Paracleto01</title>
	<script type="importmap"></script>
	<link rel="stylesheet" href="~/css/AdmAluno.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/Paracleto01.styles.css" asp-append-version="true" />

</head>
<body>

	<div id="modal-root">
		<div class="modal-backdrop">
			<div class="modal">
				<div class="modal-head">
					<div>
						<h3>Inscrever Aluno</h3>
					</div>
					<a asp-area="" asp-controller="Home" asp-action="index"> 
					<button class="modal-close" onclick="#">✕</button>
					</a>
				</div>
				<div class="modal-sub">Preencha os dados para inscrever um novo aluno.</div>
				<form>

					<div class="field">
						<label>Nome completo</label>
						<input name="nome" required="" value="" placeholder="Nome do aluno">
					</div>

					<div class="grid-2">
						  <div class="field">
							  <label>Nome do Pai</label>
							  <input name="encarregado" required="" value="" placeholder="Nome do Pai">
						  </div>
						  <div class="field">
							  <label>Nome da Mãe</label>
							  <input name="encarregado" required="" value="" placeholder="Nome do Mãe">
						  </div>
                    </div>

					<div class="grid-2">
						  <div class="field">
							  <label>Data de Nascimento</label>
							  <input name="data" required="" type="date" value="">
						  </div>
						  <div class="field">
							  	<label>Classe</label>
								<select name="classe">
									<option value="">Iniciação</option>
									<option value="">1ª Classe</option>
									<option value="">2º Classe</option>
									<option value="">3ª Classe</option>
									<option value="">4º Classe</option>
									<option value="">5ª Classe</option>
									<option value="">6º Classe</option>
									<option value="">7ª Classe</option>
									<option value="">8º Classe</option>
									<option value="">9ª Classe</option>
								</select>
						  </div>
					</div>

					<div class="grid-2">
						  <div class="field">
							  <label>Bilhete de Identidade</label>
							  <input name="bi" required="" value="" placeholder="Nº do Bilhete de Identidade">
						  </div>
						  <div class="field">
							  <label>Contacto</label>
							  <input name="contacto" required="" value="" placeholder="Contacto">
						  </div>
                    </div>

					<div class="modal-actions">
						<a asp-area="" asp-controller="Home" asp-action="index">
						  <button type="button" class="btn btn-ghost" onclick="">Cancelar</button>
						</a>
						  <button type="submit" class="btn btn-accent">Inscrever aluno</button>
					</div>
				</form>
			</div>

		</div>
	</div>


</body>
</html>



